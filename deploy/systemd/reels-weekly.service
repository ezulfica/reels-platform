[Unit]
Description=Reels Platform weekly resumable pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/reels-platform/systemd.env
ExecStart=/usr/bin/env sh -c 'exec uv --directory "$REELS_PROJECT_DIR" run reels --db "$REELS_DB_PATH" weekly-run'
