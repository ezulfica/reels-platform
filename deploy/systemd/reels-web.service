[Unit]
Description=Reels Platform local web interface
After=network.target

[Service]
Type=simple
EnvironmentFile=%h/.config/reels-platform/systemd.env
ExecStart=/usr/bin/env sh -c 'exec uv --directory "$REELS_PROJECT_DIR" run reels --db "$REELS_DB_PATH" web --port 8420'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
