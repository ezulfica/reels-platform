# Copy this file to .env only when this machine needs to capture saved Instagram media.
# It is ignored by Git. Do not commit it or share its value.
#
# The default local setup needs no LLM variables: it uses the authenticated Codex
# CLI, Luna low, and CUDA ASR. Add an override only when changing those defaults.

# Required for `reels sync`, `reels pipeline`, and `reels weekly-run`.
# Copy `sessionid` from an already authenticated Instagram browser session.
IG_SESSIONID=

# Optional: use only on a machine without an NVIDIA runtime.
# REELS_ASR_DEVICE=cpu
